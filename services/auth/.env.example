PORT=4001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/skygpt_auth

# Better Auth Configuration
BETTER_AUTH_SECRET=super_secret_dummy_auth_key_at_least_32_chars_long_12345
BETTER_AUTH_URL=http://localhost:4000/api/v1/auth

# Social Providers (Google, GitHub, Facebook)
GOOGLE_CLIENT_ID=dummy_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy_google_client_secret

GITHUB_CLIENT_ID=dummy_github_client_id
GITHUB_CLIENT_SECRET=dummy_github_client_secret

FACEBOOK_CLIENT_ID=dummy_facebook_client_id
FACEBOOK_CLIENT_SECRET=dummy_facebook_client_secret

# Initial Admin Seeding
INITIAL_ADMIN_EMAIL=admin@skygpt.com
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
INITIAL_ADMIN_NAME=Super Admin
